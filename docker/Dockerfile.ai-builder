FROM oven/bun:1-alpine AS builder

WORKDIR /app

COPY package.json bun.lock turbo.json ./
COPY apps/ai-builder/package.json apps/ai-builder/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/node-registry/package.json packages/node-registry/package.json
COPY packages/plan-guards/package.json packages/plan-guards/package.json
COPY packages/types/package.json packages/types/package.json

RUN bun install

COPY apps/ai-builder/ apps/ai-builder/
COPY packages/db/ packages/db/
COPY packages/node-registry/ packages/node-registry/
COPY packages/plan-guards/ packages/plan-guards/
COPY packages/types/ packages/types/

# Build
WORKDIR /app/apps/ai-builder
RUN bun run build

# Prune node_modules
WORKDIR /app
RUN find node_modules -type d \( -name "test" -o -name "tests" -o -name "__tests__" \
    -o -name "docs" -o -name "doc" -o -name "example" -o -name "examples" \
    -o -name ".github" -o -name ".vscode" -o -name "benchmark" -o -name "benchmarks" \
    -o -name "man" -o -name "scripts" -o -name "src" \) -exec rm -rf {} + 2>/dev/null; \
    find node_modules -type f \( -name "*.d.ts" -o -name "*.d.mts" -o -name "*.map" \
    -o -name "*.md" -o -name "*.txt" -o -name "*.yml" -o -name "*.yaml" \
    -o -name "LICENSE*" -o -name "CHANGELOG*" -o -name "HISTORY*" \
    -o -name "Makefile" -o -name "*.ts" ! -name "*.d.ts" \
    -o -name ".eslintrc*" -o -name ".prettierrc*" -o -name "tsconfig*" \
    -o -name ".editorconfig" -o -name ".npmignore" \) -delete 2>/dev/null; \
    rm -rf node_modules/.cache; \
    true


FROM oven/bun:1-alpine AS runtime

WORKDIR /app/apps/ai-builder

ENV NODE_ENV=production

# Pruned node_modules
COPY --from=builder /app/node_modules /app/node_modules

# Only compiled output — NOT the full source + all packages
COPY --from=builder /app/apps/ai-builder/dist ./dist

USER bun

EXPOSE 3001

CMD ["bun", "dist/index.js"]