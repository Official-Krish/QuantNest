FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Install dependencies (cached)
COPY package.json bun.lock turbo.json ./

COPY apps/backend/package.json apps/backend/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/market/package.json packages/market/package.json
COPY packages/node-registry/package.json packages/node-registry/package.json
COPY packages/plan-guards/package.json packages/plan-guards/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/executor-utils/package.json packages/executor-utils/package.json
COPY packages/redis/package.json packages/redis/package.json

RUN bun install

# Copy source
COPY apps/backend/ apps/backend/
COPY packages/db/ packages/db/
COPY packages/market/ packages/market/
COPY packages/node-registry/ packages/node-registry/
COPY packages/plan-guards/ packages/plan-guards/
COPY packages/types/ packages/types/
COPY packages/executor-utils/ packages/executor-utils/
COPY packages/redis/ packages/redis/

# Build backend
WORKDIR /app/apps/backend
RUN bun run build

# Prune node_modules — remove everything not needed at runtime
WORKDIR /app
RUN find node_modules -type d \( -name "test" -o -name "tests" -o -name "__tests__" \
    -o -name "docs" -o -name "doc" -o -name "example" -o -name "examples" \
    -o -name ".github" -o -name ".vscode" -o -name "benchmark" -o -name "benchmarks" \
    -o -name "man" -o -name "scripts" -o -name "src" \) -exec rm -rf {} + 2>/dev/null; \
    find node_modules -type f \( -name "*.d.ts" -o -name "*.d.mts" -o -name "*.map" \
    -o -name "*.md" -o -name "*.txt" -o -name "*.yml" -o -name "*.yaml" \
    -o -name "LICENSE*" -o -name "CHANGELOG*" -o -name "HISTORY*" \
    -o -name "Makefile" -o -name "*.ts" ! -name "*.d.ts" \
    -o -name ".eslintrc*" -o -name ".prettierrc*" -o -name "tsconfig*" \
    -o -name ".editorconfig" -o -name ".npmignore" \) -delete 2>/dev/null; \
    rm -rf node_modules/.cache; \
    true


FROM oven/bun:1-alpine AS runtime

WORKDIR /app/apps/backend

ENV NODE_ENV=production

# Pruned node_modules (externals: mongoose, bson + their transitive deps)
COPY --from=builder /app/node_modules /app/node_modules

# Compiled output only
COPY --from=builder /app/apps/backend/dist ./dist

USER bun

EXPOSE 3000

CMD ["bun", "dist/index.js"]